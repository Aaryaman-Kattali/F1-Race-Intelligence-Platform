# F1 Race Intelligence Platform — Environment Variables
# Copy this file to .env and fill in your real values. Never commit .env itself.

# ---- Existing prediction engine ----
# Optional — leave blank if you don't have a Perplexity key; the collector should degrade gracefully.
PERPLEXITY_API_KEY=
OPENWEATHER_API_KEY=your_openweather_api_key

# ---- Google Cloud (BigQuery, dbt, agent) ----
GCP_PROJECT_ID=your-gcp-project-id
GOOGLE_APPLICATION_CREDENTIALS=credentials/writer-service-account.json   # Full-access service account (ingestion + dbt)
GOOGLE_AGENT_CREDENTIALS=credentials/readonly-service-account.json      # Read-only service account (agent only)

# ---- Gemini LLM (for query agent) ----
GOOGLE_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.1-flash-lite

# ---- Optional ----
OFFLINE_MODE=false
USE_GPU=false
AGENT_MAX_BYTES=104857600
BQ_DATASET=f1_raw
SQLITE_WAREHOUSE_PATH=data/warehouse.db
MODEL_REGISTRY_DIR=models
